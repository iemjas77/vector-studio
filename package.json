{
  "name": "vector-studio",
  "version": "0.2.0",
  "private": true,
  "description": "Offline-first professional vector graphics editor",
  "license": "UNLICENSED",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:electron": "vite build && node tests/electron/smoke.mjs",
    "start": "vite build && electron .",
    "build:cli": "vite build --ssr cli/main.ts --outDir dist-cli --emptyOutDir",
    "test:cli": "npm run build:cli && node scripts/cli-smoke.mjs"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "harfbuzzjs": "^1.6.4",
    "imagetracerjs": "^1.2.6",
    "immer": "^11.2.9",
    "paper": "^0.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "^1.1.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
